---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import { getMeta } from '../lib/seo';
import { localizePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = getMeta('/404', lang);
const backHome = { en: 'Back to home', es: 'Volver al inicio' }[lang];
---
<BaseLayout
  lang={lang}
  path="/404"
  title={meta.title}
  description={meta.description}
  noindex={true}
  contactFooter={false}
  headerClass="is-clear"
>
  <main class="w-full min-h-screen flex flex-col items-center justify-center gap-8 px-8 text-center">
    <h1 class="text-6xl lg:text-8xl font-bold">404</h1>
    <p class="text-lg lg:text-xl max-w-xl">{meta.description}</p>
    <PrimaryButton href={localizePath('/', lang)} class="text-primary">{backHome}</PrimaryButton>
  </main>
</BaseLayout>
