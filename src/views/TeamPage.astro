---
import BaseLayout from '../layouts/BaseLayout.astro';
import Team from '../components/Team.astro';
import TeamMobile from '../components/TeamMobile.astro';
import OurCultureMobile from '../components/OurCultureMobile.astro';
import { getMeta, trailFor } from '../lib/seo';
import { breadcrumbs } from '../lib/schema';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = getMeta('/team', lang);
const schema = [breadcrumbs(trailFor('/team', lang), lang)];
---
<BaseLayout lang={lang} path="/team"
  schema={schema} title={meta.title} description={meta.description}>
  <main class="w-full h-auto">
    <div class="hidden lg:block"><Team lang={lang} headingLevel={1} /></div>
    <div class="lg:hidden">
      <TeamMobile lang={lang} headingLevel={1} />
      <OurCultureMobile lang={lang} />
    </div>
  </main>
</BaseLayout>
