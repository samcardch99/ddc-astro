---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateInside from '../components/interior/EstimateInside.astro';
import { getMeta, trailFor } from '../lib/seo';
import { breadcrumbs } from '../lib/schema';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = getMeta('/estimate', lang);
const schema = [breadcrumbs(trailFor('/estimate', lang), lang)];
---
<BaseLayout
  lang={lang}
  path="/estimate"
  schema={schema}
  title={meta.title}
  description={meta.description}
  header={false}
  contactFooter={false}
  whatsapp={false}
>
  <main class="w-full h-auto"><EstimateInside lang={lang} /></main>
</BaseLayout>
