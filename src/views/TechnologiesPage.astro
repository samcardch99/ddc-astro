---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnologiesInside from '../components/interior/TechnologiesInside.astro';
import { getMeta, trailFor } from '../lib/seo';
import { breadcrumbs } from '../lib/schema';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = getMeta('/technologies', lang);
const schema = [breadcrumbs(trailFor('/technologies', lang), lang)];
---
<BaseLayout
  lang={lang}
  path="/technologies"
  schema={schema}
  title={meta.title}
  description={meta.description}
  headerClass="text-secondary! is-dark2"
>
  <main class="w-full h-auto"><TechnologiesInside lang={lang} /></main>
</BaseLayout>
