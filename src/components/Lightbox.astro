---
/** Replaces react-photo-view: native <dialog>, keyboard + swipe navigation. */
---
<dialog id="ddc-lightbox" class="ddc-lightbox" data-lightbox aria-label="Image viewer">
  <button type="button" class="ddc-lightbox__close" data-lightbox-close>
    <span class="sr-only">Close</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12"></path>
    </svg>
  </button>

  <button type="button" class="ddc-lightbox__nav ddc-lightbox__nav--prev" data-lightbox-prev>
    <span class="sr-only">Previous</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
  </button>

  <img data-lightbox-image alt="" />

  <button type="button" class="ddc-lightbox__nav ddc-lightbox__nav--next" data-lightbox-next>
    <span class="sr-only">Next</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M9 18l6-6-6-6"></path>
    </svg>
  </button>

  <p class="ddc-lightbox__counter" data-lightbox-counter aria-live="polite"></p>
</dialog>

<style is:global>
  .ddc-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #c2c7cf;
    overflow: hidden;
  }

  .ddc-lightbox:not([open]) {
    display: none;
  }

  .ddc-lightbox::backdrop {
    background: rgba(15, 25, 49, 0.92);
  }

  .ddc-lightbox img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 92vw;
    max-height: 88dvh;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .ddc-lightbox img[data-loaded='true'] {
    opacity: 1;
  }

  .ddc-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
  }

  .ddc-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    transition: opacity 0.2s ease;
    opacity: 0.7;
  }

  .ddc-lightbox__nav:hover {
    opacity: 1;
  }

  .ddc-lightbox__nav--prev {
    left: 0.5rem;
  }
  .ddc-lightbox__nav--next {
    right: 0.5rem;
  }

  .ddc-lightbox__close svg,
  .ddc-lightbox__nav svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .ddc-lightbox__counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.875rem;
    opacity: 0.8;
  }
</style>
