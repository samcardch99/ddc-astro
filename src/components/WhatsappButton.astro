---
import { site } from '../lib/site';
---
<div class="fixed z-[201] right-4 bottom-8 lg:bottom-12">
  <a
    href={`https://wa.me/${site.whatsapp}`}
    target="_blank"
    rel="noreferrer noopener"
    class="w-14 h-14 bg-white rounded-full shadow-lg flex items-center justify-center hover:scale-110 transition-transform"
    aria-label="WhatsApp"
  >
    <!-- The original animated a .lottie file here (~90 kB of player JS).
         The identical glyph as inline SVG costs nothing and paints instantly. -->
    <svg viewBox="0 0 32 32" class="w-9 h-9" aria-hidden="true">
      <path
        fill="#25D366"
        d="M16.004 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.257.592 4.463 1.716 6.406L3.2 28.8l6.55-1.696a12.75 12.75 0 0 0 6.254 1.614h.006c7.058 0 12.8-5.74 12.8-12.8 0-3.42-1.332-6.635-3.75-9.053a12.71 12.71 0 0 0-9.056-3.665Zm0 23.09h-.005a10.63 10.63 0 0 1-5.417-1.483l-.389-.23-4.026 1.042 1.075-3.926-.253-.403a10.6 10.6 0 0 1-1.626-5.69c0-5.867 4.775-10.641 10.646-10.641a10.57 10.57 0 0 1 7.522 3.12 10.57 10.57 0 0 1 3.117 7.529c-.003 5.868-4.777 10.682-10.644 10.682Z"
      ></path>
      <path
        fill="#25D366"
        d="M21.842 18.62c-.32-.16-1.892-.933-2.185-1.04-.293-.107-.506-.16-.72.16-.212.32-.825 1.04-1.012 1.253-.186.213-.373.24-.693.08-.32-.16-1.35-.498-2.572-1.587-.95-.848-1.592-1.895-1.779-2.215-.186-.32-.02-.493.14-.652.144-.144.32-.373.48-.56.16-.187.213-.32.32-.533.107-.213.053-.4-.027-.56-.08-.16-.72-1.734-.986-2.374-.26-.623-.523-.539-.72-.549l-.613-.01c-.213 0-.56.08-.853.4-.293.32-1.12 1.094-1.12 2.667s1.146 3.094 1.306 3.307c.16.213 2.256 3.444 5.465 4.83.764.33 1.36.527 1.825.674.767.244 1.465.21 2.017.128.615-.092 1.892-.774 2.159-1.521.266-.747.266-1.387.186-1.52-.08-.134-.293-.214-.613-.374Z"
      ></path>
    </svg>
  </a>
</div>
