---
import { site } from '../lib/site';

interface Props {
  class?: string;
  width?: string;
}
const { class: className = '', width = '100%' }: Props = Astro.props;
---
<div id="appointment" class={`relative h-fit ${className}`} data-booking-widget>
  <iframe
    src={site.booking}
    style={`width: ${width}; border: none; overflow: visible;`}
    id="1FWmMbyLslj9CnJDOv7e_1747676594550"
    title="LeadConnector Booking Widget"
    loading="lazy"></iframe>
</div>

<!-- LeadConnector resizes the iframe to fit the calendar over postMessage.
     Without this the frame stays at the 150px default. The React component
     appended the same script on mount; `defer` keeps it off the parse path. -->
<script is:inline defer src={site.bookingScript}></script>
