---
/**
 * shadcn-style button in DDC clothing. Geometry, focus ring and transition
 * timing follow shadcn/ui's `button` recipe; every colour comes from the DDC
 * palette so it sits beside the site's pill buttons without clashing.
 */
interface Props {
  variant?: 'default' | 'outline' | 'ghost';
  size?: 'default' | 'lg' | 'sm';
  as?: 'button' | 'a';
  href?: string;
  type?: 'button' | 'submit';
  id?: string;
  class?: string;
  disabled?: boolean;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'default',
  size = 'default',
  as = 'button',
  href = '#',
  type = 'button',
  id,
  class: className = '',
  disabled = false,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-bold tracking-[0.08em] ' +
  'transition-[background-color,border-color,color,box-shadow,opacity] duration-150 ease-out ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-secondary ' +
  'disabled:pointer-events-none disabled:opacity-40 select-none';

const variants = {
  default: 'bg-primary text-secondary shadow-[0_1px_2px_rgba(0,0,0,0.35)] hover:bg-primary/90 active:bg-primary/80',
  outline: 'border border-white/20 bg-transparent text-primary hover:bg-white/10 hover:border-white/35',
  ghost: 'bg-transparent text-primary hover:bg-white/10',
} as const;

const sizes = {
  default: 'h-10 px-5 text-sm',
  lg: 'h-12 px-7 text-base',
  sm: 'h-8 px-3.5 text-xs',
} as const;

const classes = `${base} ${variants[variant as keyof typeof variants]} ${sizes[size as keyof typeof sizes]} ${className}`;
---
{
  as === 'a' ? (
    <a id={id} href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
