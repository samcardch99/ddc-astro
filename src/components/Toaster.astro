---
/** Minimal replacement for `sonner`'s <Toaster position="bottom-right" />. */
---
<div id="ddc-toaster" class="fixed bottom-4 right-4 z-[400] flex flex-col gap-2 pointer-events-none" aria-live="polite" aria-atomic="false"></div>

<style is:global>
  .ddc-toast {
    pointer-events: auto;
    max-width: 22rem;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.35;
    background: #fff;
    color: #0f1931;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(15, 25, 49, 0.1);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .ddc-toast[data-visible='true'] {
    opacity: 1;
    transform: none;
  }

  .ddc-toast[data-type='error'] {
    border-color: rgba(220, 38, 38, 0.4);
    color: #7f1d1d;
  }

  .ddc-toast__title {
    font-weight: 700;
  }

  .ddc-toast__description {
    opacity: 0.8;
  }
</style>
