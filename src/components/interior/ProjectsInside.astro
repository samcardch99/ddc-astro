---
import { Image } from 'astro:assets';
import FooterBanner from '../FooterBanner.astro';
import AnimatedBackground from '../AnimatedBackground.astro';
import projects from '../../data/villas.json';
import { villaAssetFromPublicPath } from '../../lib/images';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = projects.map((p) => ({
  folder: p.folder,
  name: p.name,
  location: p.city,
  href: localizePath(`/projects/${p.folder}`, lang),
  asset: villaAssetFromPublicPath(p.image),
}));

const cities = [...new Set(items.map((i) => i.location))];
const cityLabels: Record<string, string> = { 'Lehigh Acres': 'Lehigh' };
---
<section id="our-projects" class="relative z-20 min-h-screen w-full bg-primary">
  <div class="absolute inset-0 -z-10 bg-black opacity-80"></div>
  <AnimatedBackground />

  <div
    class="bg-primary pb-12 sticky top-0 z-20 [mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]"
  >
    <div class="absolute inset-0 -z-10 bg-black opacity-80"></div>
    <div class="px-8 pt-24 mb-6">
      <div class="flex lg:flex-row flex-col w-full lg:justify-between lg:items-center">
        <h1 class="text-4xl font-bold text-primary mb-4">{t('projects_inside.title')}</h1>

        <div class="relative">
          <label class="sr-only" for="projects-search">{t('projects_inside.search')}</label>
          <input
            id="projects-search"
            type="search"
            data-projects-search
            placeholder={t('projects_inside.search')}
            class="w-full lg:w-[20vw] rounded-full border border-white/20 bg-white/5 text-primary placeholder:text-white/50 px-5 py-3 pr-12 outline-none focus:border-white/40"
          />
          <svg
            class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/70 pointer-events-none"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-3.5-3.5"></path>
          </svg>
        </div>
      </div>

      <div class="mt-4 mb-8 flex flex-row items-center justify-between relative">
        <span
          class="absolute -bottom-8 lg:-bottom-16 left-2 -translate-x-1/2 text-primary opacity-40 text-2xl"
          aria-hidden="true">+</span
        >
        <span
          class="absolute -bottom-8 lg:-bottom-16 right-2 translate-x-1/2 text-primary opacity-40 text-2xl"
          aria-hidden="true">+</span
        >

        <div class="flex items-center gap-2 text-white" role="group" aria-label="View">
          <button
            type="button"
            data-projects-view="list"
            class="projects-view-btn py-1 rounded-lg text-sm font-semibold transition-colors text-grey/50 hover:bg-white/20"
            >{t('projects_inside.list')}</button
          >
          <span aria-hidden="true">/</span>
          <button
            type="button"
            data-projects-view="grid"
            class="projects-view-btn py-1 rounded-lg text-sm font-semibold transition-colors text-grey/50 hover:bg-white/20"
            >{t('projects_inside.grid')}</button
          >
        </div>

        <div class="flex items-center justify-between relative">
          <label class="sr-only" for="projects-location">{t('projects_inside.location')}</label>
          <select
            id="projects-location"
            data-projects-location
            class="appearance-none cursor-pointer bg-transparent border relative border-white/20 text-primary rounded-full w-fit pl-2 pr-8 py-3 text-sm"
          >
            <option value="" disabled selected>{t('projects_inside.location')}</option>
            {cities.map((city) => <option value={city}>{cityLabels[city] ?? city}</option>)}
            <option value="All">{t('projects_inside.all')}</option>
          </select>
          <svg
            class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="px-8 pb-32 min-h-screen">
    <div
      data-projects-list
      data-view="grid"
      class="projects-collection grid grid-cols-1 md-custom:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10"
    >
      {
        items.map((item, index) => (
          <a
            href={item.href}
            class="project-card group aspect-video p-3 relative block text-left"
            data-project-card
            data-name={item.name.toLowerCase()}
            data-location={item.location}
            data-index={index}
          >
            <span
              class="left-span absolute -bottom-4 left-0 lg:-left-5 -translate-x-1/2 text-primary opacity-40 text-2xl lg:hidden"
              aria-hidden="true"
            >
              +
            </span>
            <span
              class="right-span absolute -bottom-4 right-0 lg:-right-5 translate-x-1/2 text-primary opacity-40 text-2xl"
              aria-hidden="true"
            >
              +
            </span>
            <div class="project-card-media overflow-hidden shadow-[0_18px_35px_-10px_rgba(0,0,0,.45)]">
              {item.asset && (
                <Image
                  src={item.asset}
                  alt={item.name}
                  widths={[480, 960]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 637px) 50vw, 90vw"
                  format="webp"
                  quality={72}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding={index < 3 ? 'sync' : 'async'}
                  class="h-[180px] sm:h-[200px] md:h-[220px] lg:aspect-video lg:h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                />
              )}
            </div>
            <div class="project-card-meta mt-3 flex items-center justify-between border-b border-primary text-primary">
              <span class="font-semibold">{item.name}</span>
              <span class="text-sm opacity-80">2025</span>
            </div>
            <p class="project-card-city mt-1 text-xs w-fit absolute right-0 pr-3 text-white/60">
              {item.location}
            </p>
          </a>
        ))
      }
    </div>

    <p class="text-white/70 mt-6 hidden" data-projects-empty>No projects found.</p>
  </div>

  <div class="sticky inset-x-0 bottom-0 mix-blend-difference">
    <FooterBanner lang={lang} />
  </div>
</section>

<style>
  /* Each card mounted with framer's `initial={{opacity:0}} →
     animate={{opacity:1}}` over 0.3s. */
  .project-card {
    animation: ddc-card-fade 0.3s ease both;
  }

  @keyframes ddc-card-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none;
    }
  }

  .projects-view-btn[aria-pressed='true'] {
    color: var(--color-primary);
  }

  /* List view reuses the same DOM: hide the media, collapse to a text row. */
  .projects-collection[data-view='list'] {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .projects-collection[data-view='list'] .project-card {
    aspect-ratio: auto;
    padding: 0;
  }

  .projects-collection[data-view='list'] .project-card-media,
  .projects-collection[data-view='list'] .left-span,
  .projects-collection[data-view='list'] .right-span,
  .projects-collection[data-view='list'] .project-card-city {
    display: none;
  }

  .projects-collection[data-view='list'] .project-card-meta {
    margin-top: 0;
    padding-bottom: 0.5rem;
    border-bottom: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .project-card[hidden] {
    display: none;
  }
</style>
