---
interface Props {
  href?: string;
  class?: string;
  id?: string;
  type?: 'button' | 'submit';
  as?: 'a' | 'button';
}

const {
  href = '/',
  class: className = '',
  id,
  type = 'button',
  as = 'a',
}: Props = Astro.props;

const base =
  'px-4 py-2 border border-primary rounded-full font-bold tracking-wide hover:bg-white/10 transition-colors duration-300 w-fit h-fit';
---
{
  as === 'button' ? (
    <button id={id} type={type} class={`${className} ${base}`}>
      <slot />
    </button>
  ) : (
    <a id={id} href={href} class={`${className} ${base}`}>
      <slot />
    </a>
  )
}
