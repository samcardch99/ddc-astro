# EmailJS credentials used by the contact form.
# These are browser-side ("public") keys — they ship in the JS bundle — but they
# are still kept out of git so they can be rotated without a code change.
# In CI they come from repository secrets of the same name.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_INVESTMENTS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
